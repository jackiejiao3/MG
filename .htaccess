# Canonical redirects apply only to the public Modern Group domain.
<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{HTTP_HOST} ^(www\.)?modernhig\.com$ [NC]
RewriteCond %{THE_REQUEST} !\s/+index\.html[?\s]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.modernhig\.com$
RewriteRule ^(.*)$ https://www.modernhig.com/$1 [L,R=301]

RewriteCond %{HTTP_HOST} ^(www\.)?modernhig\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s]
RewriteRule ^index\.html$ https://www.modernhig.com/ [R=301,L]

RewriteCond %{HTTP_HOST} ^(www\.)?modernhig\.com$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.modernhig\.com$ [NC]
RewriteRule ^ https://www.modernhig.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>
